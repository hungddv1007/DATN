# Copy this file to .env and fill in local values.
# Never commit the real .env file.

DB_URL=jdbc:sqlserver://localhost:1433;databaseName=GymProDB;encrypt=false;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=replace-with-local-database-password

# Base64-encoded secret with at least 32 bytes of entropy.
JWT_SECRET=replace-with-base64-encoded-jwt-secret
JWT_EXPIRATION=1800000

MAIL_USERNAME=replace-with-email-address
MAIL_PASSWORD=replace-with-mail-app-password

GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
VITE_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_NUTRITION_MODEL=gemini-3.5-flash-lite
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_CHAT_COMPLEX_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT=30s
GEMINI_CHAT_HISTORY_LIMIT=12
GEMINI_FREE_TIER_REQUESTS_PER_HOUR=10
GEMINI_FREE_TIER_REQUESTS_PER_DAY=50
GEMINI_CONVERSATION_RETENTION_DAYS=90

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=5MB
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
